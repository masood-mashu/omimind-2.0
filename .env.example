# Required before adding Omi webhook URLs. Use a long random string; never commit .env.
OMI_WEBHOOK_TOKEN=replace-with-a-long-random-secret
# Set this to the verified workspace ID shown after signing in. Omi callbacks are bound to this user.
OMI_WEBHOOK_UID=

# Supabase Auth. The publishable key is browser-safe; never add a service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Lyzr Studio agent (required for grounded answers)
LYZR_API_KEY=
LYZR_AGENT_ID=
LYZR_ACTION_EXTRACTOR_AGENT_ID=
# Optional manager-agent workers; use Lyzr's id/name/usage_description values as JSON.
LYZR_MANAGED_AGENTS=
LYZR_INFERENCE_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
LYZR_TIMEOUT_SECONDS=45

# Qdrant Cloud is recommended for a persistent deployed instance.
# Leave QDRANT_URL blank to use local embedded Qdrant in ./qdrant_data.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=omimind_meetings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_CACHE_DIR=./.runtime/fastembed-cache
HF_HOME=./.runtime/huggingface

# Comma-separated browser origins. Add the exact Vercel URL if hosting the UI there.
ALLOWED_ORIGINS=http://localhost:5173
PORT=8000
