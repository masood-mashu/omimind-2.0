entrypoint = "README.md"
modules = ["python-3.11", "nodejs-20"]
run = "npm install --prefix frontend && npm run build --prefix frontend && pip install -r server/requirements.txt && uvicorn server.app:app --host 0.0.0.0 --port 3000"

[deployment]
run = ["sh", "-c", "npm install --prefix frontend && npm run build --prefix frontend && pip install -r server/requirements.txt && uvicorn server.app:app --host 0.0.0.0 --port 3000"]
deploymentTarget = "cloudrun"
